# ============================
# Telegram Bot Configuration
# ============================
BOT_TOKEN=your_bot_token_here

# ============================
# Database Configuration
# ============================
# Supabase PostgreSQL URL format:
# postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/biznes_bot

# Supabase (optional - for direct API access)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ============================
# Admin Configuration
# ============================
# Telegram user ID of the admin
ADMIN_IDS=123456789,987654321

# ============================
# App Configuration
# ============================
# Environment: development, production
ENVIRONMENT=development

# Default timezone
DEFAULT_TIMEZONE=Asia/Tashkent

# Bot name (displayed in messages)
BOT_NAME=Biznes Hisob Bot

# ============================
# Logging
# ============================
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# ============================
# Rate Limiting
# ============================
THROTTLE_RATE=0.5
